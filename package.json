{
    "name": "ycloud-websocket-inspector",
    "version": "0.6.6",
    "private": true,
    "description": "监听 SharedWorker WebSocket 消息。",
    "type": "module",
    "scripts": {
        "dev": "wxt",
        "build": "wxt build",
        "zip": "wxt zip",
        "check": "tsc --noEmit",
        "lint": "oxlint --deny-warnings src tests wxt.config.ts",
        "format": "oxfmt --write .",
        "format:check": "oxfmt --check .",
        "quality": "bun run format:check && bun run lint && bun run check",
        "test": "bun test tests/*.test.mjs",
        "postinstall": "wxt prepare"
    },
    "dependencies": {
        "dayjs": "^1.11.23"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.0.0",
        "@tanstack/react-table": "^9.2.4",
        "@tanstack/react-virtual": "^3.13.12",
        "@types/chrome": "^0.2.8",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@wxt-dev/module-react": "^1.1.3",
        "dexie": "^4.0.11",
        "lucide-react": "^0.468.0",
        "oxfmt": "^0.66.0",
        "oxlint": "^1.81.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "react-resizable-panels": "^4.9.0",
        "tailwindcss": "^4.0.0",
        "tslib": "^2.8.1",
        "typescript": "^7.0.2",
        "vite": "^8.1.5",
        "web-ext": "^10.5.0",
        "wxt": "^0.21.4"
    },
    "packageManager": "bun@1.4.0"
}
